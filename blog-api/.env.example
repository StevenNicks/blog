PORT=4000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/blog_api

JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES=7d

# Uno o varios orígenes del frontend separados por coma (el primero se usa por defecto en los correos).
# Admite * como comodín de un segmento, p. ej. http://192.168.1.*:3000
CLIENT_URL=http://localhost:3000,http://192.168.3.70:3000,http://192.168.1.*:3000

UPLOAD_MAX_MB=5

SEED_ADMIN_EMAIL=admin@blog.com
SEED_ADMIN_PASSWORD=Admin12345!

# Correo (Outlook/Hotmail). Si SMTP_HOST esta vacio, los correos se imprimen en consola
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=tu_correo@outlook.com
SMTP_PASS=
EMAIL_FROM="Blog <tu_correo@outlook.com>"
# Nombre que aparece en las plantillas de correo (por defecto: Blog)
APP_NAME=Blog
